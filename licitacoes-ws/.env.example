# Banco de dados
# PostgreSQL (produção):
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# SQLite (desenvolvimento local, sem instalar nada):
# DATABASE_URL=sqlite:///./database.db

# Auth
SECRET_KEY=gere-uma-string-longa-e-aleatoria-aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis (fila do Celery)
# Use REDIS_URL (tem prioridade) OU o par REDIS_HOST + REDIS_PASSWORD.
REDIS_URL=redis://default:senha@host:porta/0
# REDIS_HOST=host:porta
# REDIS_PASSWORD=senha

# Qdrant (banco vetorial)
QDRANT_HOST=https://seu-cluster.qdrant.io
QDRANT_API_KEY=sua-chave

# Groq (modelo de linguagem) - https://console.groq.com
GROQ_API_KEY=gsk_...

# Cohere (reordenacao dos trechos na busca) - opcional; sem ela a busca funciona sem reordenar
COHERE_API_KEY=

# CORS - origens que podem chamar a API, separadas por virgula
ALLOWED_ORIGINS=https://SEU-APP.onrender.com,http://localhost:4200,http://localhost:4201

# true: o worker Celery sobe junto com a API (desenvolvimento). false: worker em processo separado (Docker).
START_CELERY_WORKER=true
